<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- 继承 Spring Boot 父 POM：统一管理依赖版本、编译插件、打包方式 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

  <groupId>com.example</groupId>
  <artifactId>ByteBlog</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>ByteBlog</name>
  <url>http://maven.apache.org</url>

    <properties>
        <!-- Spring Boot 3.x 要求 Java 17+ -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 自定义版本号 -->
        <mybatis-spring-boot.version>3.0.3</mybatis-spring-boot.version>
        <jjwt.version>0.12.5</jjwt.version>
        <knife4j.version>4.5.0</knife4j.version>
        <langchain4j.version>1.10.0</langchain4j.version>
        <langgraph4j.version>1.9.7</langgraph4j.version>
    </properties>

  <dependencies>
      <!-- SpringMVC + 内嵌 Tomcat + Jackson，提供 REST 接口能力 -->
      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-web</artifactId>
      </dependency>

      <!-- JSR-380 参数校验（@NotBlank / @NotNull / @Size 等） -->
      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-validation</artifactId>
      </dependency>

      <!-- ==================== 持久层 ==================== -->

      <dependency>
          <groupId>com.baomidou</groupId>
          <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
          <version>3.5.7</version> <!-- 建议使用最新稳定版 -->
      </dependency>

      <!-- MySQL 8 驱动，运行时才需要 -->
      <dependency>
          <groupId>com.mysql</groupId>
          <artifactId>mysql-connector-j</artifactId>
          <scope>runtime</scope>
      </dependency>

      <!-- ==================== 开发效率 ==================== -->

      <!-- Lombok：@Data / @Builder / @RequiredArgsConstructor 等注解，编译期生成代码 -->
      <dependency>
          <groupId>org.projectlombok</groupId>
          <artifactId>lombok</artifactId>
          <optional>true</optional>
      </dependency>

      <!-- Knife4j：基于 OpenAPI3 的在线接口文档，访问 /doc.html -->
      <dependency>
          <groupId>com.github.xiaoymin</groupId>
          <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
          <version>${knife4j.version}</version>
      </dependency>

      <!-- ==================== 测试 ==================== -->

      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-test</artifactId>
          <scope>test</scope>
      </dependency>
      <dependency>
          <groupId>org.springframework.security</groupId>
          <artifactId>spring-security-test</artifactId>
          <scope>test</scope>
      </dependency>
      <!-- Excel 读写，用于批量导入数据 -->
      <dependency>
          <groupId>com.alibaba</groupId>
          <artifactId>easyexcel</artifactId>
          <version>3.3.4</version>
      </dependency>
      <!-- redis -->
      <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-data-redis</artifactId>
          <version>3.2.5</version>
      </dependency>
      <!-- ip2region 离线 IP 地址定位库 -->
      <dependency>
          <groupId>org.lionsoul</groupId>
          <artifactId>ip2region</artifactId>
          <version>3.3.7</version>
      </dependency>
      <!-- JWT：登录鉴权签发/校验 token -->
      <dependency>
          <groupId>io.jsonwebtoken</groupId>
          <artifactId>jjwt-api</artifactId>
          <version>${jjwt.version}</version>
      </dependency>
      <dependency>
          <groupId>io.jsonwebtoken</groupId>
          <artifactId>jjwt-impl</artifactId>
          <version>${jjwt.version}</version>
          <scope>runtime</scope>
      </dependency>
      <dependency>
          <groupId>io.jsonwebtoken</groupId>
          <artifactId>jjwt-jackson</artifactId>
          <version>${jjwt.version}</version>
          <scope>runtime</scope>
      </dependency>
      <!-- BCrypt 密码加密 -->
      <dependency>
          <groupId>org.springframework.security</groupId>
          <artifactId>spring-security-crypto</artifactId>
      </dependency>

      <dependency>
          <groupId>org.springframework.ai</groupId>
          <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
          <version>1.1.2</version>
      </dependency>
      <!-- LangChain4j OpenAI 兼容（接 Qwen） -->
      <dependency>
          <groupId>dev.langchain4j</groupId>
          <artifactId>langchain4j-open-ai</artifactId>
          <version>${langchain4j.version}</version>
      </dependency>
      <dependency>
          <groupId>dev.langchain4j</groupId>
          <artifactId>langchain4j</artifactId>
          <version>${langchain4j.version}</version>
      </dependency>
      <!-- LangGraph4j 核心 -->
      <dependency>
          <groupId>org.bsc.langgraph4j</groupId>
          <artifactId>langgraph4j-core</artifactId>
          <version>${langgraph4j.version}</version>
      </dependency>
      <!-- 官方 MySQL 检查点模块 -->
      <dependency>
          <groupId>org.bsc.langgraph4j</groupId>
          <artifactId>langgraph4j-mysql-saver</artifactId>
          <version>${langgraph4j.version}</version>
      </dependency>

  </dependencies>
    <build>
        <resources>
            <!-- 1. 排除所有的 xdb 文件，防止 Maven 默认压缩损坏二进制文件 -->
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/*.xdb</exclude>
                </excludes>
            </resource>
            <!-- 2. 单独将 xdb 文件打包，且不做任何过滤 (filtering=false) -->
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.xdb</include>
                </includes>
                <filtering>false</filtering>
            </resource>
            <!-- 3. 默认的其他配置文件 -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <!-- Spring Boot 打包插件：生成可执行 jar，排除 lombok -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
